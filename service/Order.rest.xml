<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="file://C:\Users\HP\OneDrive\Desktop\sandbox\moqui-framework\framework\xsd\rest-api-3.xsd"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd"
          name="order" displayName="Order RestApi" version="2.0.0" >




    <resource name="orders" require-authentication="anonymous-all">
        <method type="post">
            <service name="OrderService.create#OrderHeader"/>
        </method>
        <id name="orderId">
            <method type="get">
                <service name="OrderService.find#OrderHeader"/>
            </method>
            <method type="patch">

                <entity name="OrderItem" operation="store"/>
<!--                <service name="OrderService.patch#OrderHeader"/>-->
            </method>
            <method type="delete">
                <service name="OrderService.delete#OrderHeader"/>
            </method>

            <resource name="items" require-authentication="anonymous-all">
                <method type="post">
                    <service name="OrderService.create#OrderItem"/>
                </method>
            </resource>

        </id>
    </resource>

    <resource name="orderItem" require-authentication="anonymous-all">

        <method type="get">
            <entity name="OrderItem" operation="list"/>
        </method>
        <method type="delete">
            <service name="OrderService.delete#OrderItem"/>
        </method>

    </resource>


</resource>


